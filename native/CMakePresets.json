{
  "version": 8,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-x64",
      "displayName": "Windows x64 Release",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build_x64",
      "warnings": {
        "dev": true,
        "deprecated": true
      },
      "cacheVariables": {
        "BAMBU_OVERLAY_BUILD_PLUGIN": true,
        "BAMBU_OVERLAY_BUILD_TESTS": true,
        "BAMBU_OVERLAY_BOOTSTRAP_OBS": true,
        "CMAKE_COMPILE_WARNING_AS_ERROR": true
      }
    },
    {
      "name": "core-tests",
      "displayName": "OBS-independent core tests",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build_core",
      "cacheVariables": {
        "BAMBU_OVERLAY_BUILD_PLUGIN": false,
        "BAMBU_OVERLAY_BUILD_TESTS": true,
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x64",
      "configurePreset": "windows-x64",
      "configuration": "Release"
    },
    {
      "name": "core-tests",
      "configurePreset": "core-tests"
    }
  ],
  "testPresets": [
    {
      "name": "windows-x64",
      "configurePreset": "windows-x64",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "core-tests",
      "configurePreset": "core-tests",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
