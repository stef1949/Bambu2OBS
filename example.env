# Bambu2OBS Environment Variables

# Your Bambu Cloud account email
EMAIL=your_email@domain.com

# Your Bambu Cloud account password
PASSWORD=your_password_here

# Leave the username as bblp
USERNAME=bblp

# Set the region if needed (default is 'global')
REGION=global

# Printer-specific details
PRINTER_SN=your_printer_serial_number
PRINTER_IP=printer_ip_address
ACCESS_CODE=your_access_code_here

# Preferred: SHA-256 fingerprint of the printer's MQTT/FTPS TLS certificate.
# Colons and letter case are ignored. Leave empty only when using a
# system-trusted certificate or the explicit insecure exception below.
PRINTER_TLS_FINGERPRINT_SHA256=

# Compatibility escape hatch for self-signed printer certificates.
# This must be explicitly enabled and does not verify printer identity.
ALLOW_INSECURE_PRINTER_TLS=false

# The name of the folder that will contain the displayed printer data / details
BASE_DIR=data

# Optional: Bambu Cloud token (recommended for accounts using verification-code login)
BAMBU_CLOUD_TOKEN=

# Overlay and bounded-download settings
OVERLAY_REFRESH_MS=5000
OVERLAY_REQUEST_TIMEOUT_MS=4000
OVERLAY_STALE_AFTER_SECONDS=30
PROGRESS_SERVER_PORT=5000
SD_PREVIEW_RETRY_SECONDS=45
MAX_PREVIEW_IMAGE_BYTES=10485760
MAX_3MF_ARCHIVE_BYTES=268435456
MAX_3MF_MEMBER_COUNT=4096

# Writes a maximum of five redacted MQTT diagnostic entries when enabled.
DEBUG_DUMPS=false
